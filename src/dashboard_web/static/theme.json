{
  "name": "beige-graphite-v1",
  "description": "Beige(#F5EFE0) + Dark Gray(#1A1A1A) 라이트 테마. 경계를 '선'이 아니라 '면 대비 + 그림자'로 표현. colors는 --xxx + --xxx-rgb 로, tokens는 --xxx 로 server가 주입. 이 JSON만 고치면 전체 디자인(색·모서리·그림자·간격)이 한 번에 바뀜.",
  "colors": {
    "bg":          "#F5EFE0",
    "panel":       "#FBF7EC",
    "elevated":    "#FFFDF7",
    "grid":        "#E4DCC9",
    "line":        "#DED3BC",
    "line-strong": "#B9AC91",
    "fg":          "#1A1A1A",
    "dim":         "#6B6459",
    "muted":       "#8C8377",
    "cyan":        "#1F6F78",
    "green":       "#2E7D4F",
    "yellow":      "#A97A0B",
    "orange":      "#C1600F",
    "red":         "#C0392B",
    "purple":      "#6B4FA8"
  },
  "tokens": {
    "radius-sm":    "5px",
    "radius-md":    "9px",
    "radius-lg":    "14px",
    "border-w":     "1px",
    "shadow-sm":    "0 1px 2px rgba(26,26,26,0.10)",
    "shadow-md":    "0 4px 14px rgba(26,26,26,0.12)",
    "shadow-lg":    "0 14px 40px rgba(26,26,26,0.20)",
    "ring":         "0 0 0 2px rgba(31,111,120,0.30)"
  }
}
