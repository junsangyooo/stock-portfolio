data/autotrade.db
data/autotrade.db-*
data/autotrade.secret
data/autotrade-toss/
data/deploy/
web/node_modules/
# On the server web/dist is a symlink to web/releases/<id> (deploy/deploy.sh): no trailing slash,
# or the link would not match.
web/dist
web/releases/
web/test-results/
web/playwright-report/
web/coverage/
!web/public/**/*.png
