# /etc/logrotate.d/stock-portfolio
#
# Nothing rotated data/logs, so every file only ever grew — dashboard.log
# reached 10MB / 81k lines and fundamental.log 5MB by 2026-09. Install:
#
#   sudo apt-get install -y logrotate            # not present by default here
#   sudo cp deploy/logrotate-stock-portfolio /etc/logrotate.d/stock-portfolio
#   sudo chown ubuntu:ubuntu ~/stock-portfolio/data/logs/dashboard.log
#   sudo logrotate -d /etc/logrotate.d/stock-portfolio   # dry run
#
# One glob, not one block per file: a path may appear in only one stanza and
# dashboard.log is inside this directory like the rest.
#
# copytruncate, not create: systemd holds dashboard.log open with `append:`,
# so a rename would leave the service writing to an unlinked inode and the
# new file would stay empty until the next restart.
#
# `su ubuntu ubuntu` is required, not optional: data/logs is group-writable
# (drwxrwxr-x ubuntu ubuntu) and logrotate refuses a directory it does not
# consider secure unless told whose privileges to drop to. That makes ubuntu
# the one doing the truncating, which is why dashboard.log has to belong to
# ubuntu — systemd creates it as root, and copytruncate needs write access to
# the file itself. The chown holds: `append:` never re-creates an existing
# file, and copytruncate never unlinks one.
/home/ubuntu/stock-portfolio/data/logs/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su ubuntu ubuntu
}
