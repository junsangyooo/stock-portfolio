[Unit]
Description=portfolio-dashboard (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/portfolio-dashboard
EnvironmentFile=/home/ubuntu/dotclaude/secrets/.env
# UnsetEnvironment=, NOT Environment="X=". EnvironmentFile= is read at exec
# and its values win over every Environment= line regardless of the order
# they appear in, so `Environment="ANTHROPIC_API_KEY="` had been inert since
# the day it was written — verified 2026-09-10 by reading /proc/PID/environ
# on the running service, which still held the real key. UnsetEnvironment= is
# the one directive systemd applies after everything else.
#
#   ANTHROPIC_API_KEY  a present key routes the Claude CLI to paid API
#                      billing (ops notes §7). llm_backend.py pops it from
#                      every subprocess env, which is what actually held the
#                      line; this is the second layer, now real.
#   KRX_ID / KRX_PW    pykrx logs into KRX at import time whenever these are
#                      set, so the web process held a session and renewed it
#                      hourly — one login per restart, 114 in the log. Bulk
#                      KRX queries are a cron's job and the server only reads
#                      the parquet cache they leave behind (§8); a second
#                      session competes with the screener's for one account.
#
#   TOSS_CLIENT_ID / TOSS_CLIENT_SECRET / TOSS_ACCOUNT_NO
#                      the live Toss account's keys (2026-10-13). The old quant
#                      behind its PIN still has /api/quant/plans (arms 조건주문),
#                      /sync and /orders/cancel_all (cancels every open and
#                      conditional order of the account, the new engine's too),
#                      and a token it mints revokes the new tick's (one token
#                      per client). src/quant/broker/toss.py reads the first two
#                      (creds()); the third names the account. Nothing on the
#                      portfolio side calls Toss (only src/quant/* and
#                      src/api/quant.py import that client).
#
# core.secrets.get() falls back to reading the .env file itself when the
# environment lacks a name, so unsetting alone would not keep the Toss keys
# out: the secrets folder is also hidden from this process
# (InaccessiblePaths=; EnvironmentFile= above is read by systemd before the
# service starts, so the environment it loads is unchanged). With both, a
# name unset here is out of reach for the web process, on purpose or not.
# The names it does read through core.secrets (DISCORD_WEBHOOK_URL, KIS_*,
# DART_API_KEY) still come from the environment. Cron jobs (src/quant's keeper
# and cycle_job) do not run under this unit: their crontab lines go before
# live is turned on (autotrade/PHASE3.md 4).
UnsetEnvironment=ANTHROPIC_API_KEY KRX_ID KRX_PW TOSS_CLIENT_ID TOSS_CLIENT_SECRET TOSS_ACCOUNT_NO
InaccessiblePaths=-/home/ubuntu/dotclaude/secrets -/home/ubuntu/.claude/secrets
ExecStart=/home/ubuntu/portfolio-dashboard/.venv/bin/python -m src.dashboard_web.server --port 8888 --host 127.0.0.1
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/portfolio-dashboard/data/logs/dashboard.log
StandardError=append:/home/ubuntu/portfolio-dashboard/data/logs/dashboard.log

[Install]
WantedBy=multi-user.target
